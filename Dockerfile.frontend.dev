# Dockerfile.dev — Frontend (Vite dev server with hot reload)
# Place this file in the mengu-ai-frontend repo root as "Dockerfile.dev"

FROM node:20-alpine

WORKDIR /app

# Install dependencies first (cached layer)
COPY package*.json ./
RUN npm ci

# Source is mounted as a volume at runtime (see docker-compose.yml)
EXPOSE 3001

CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0", "--port", "3001"]
